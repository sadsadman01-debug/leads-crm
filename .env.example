# Frontend (Vite) — safe to expose in the browser bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Netlify Functions (server-side only — set these in the Netlify dashboard, never commit real values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by scripts/seed-admin.mjs to create the single admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-running
